<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Caravelle</PackageId>
    <Authors>Lodewijk Sioen</Authors>
    <Description>Caravelle is a source-generator-driven in-memory request-response bus. Like Mediatr, but without the generics.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/LodewijkSioen/Caravelle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LodewijkSioen/Caravelle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>source-generator;mediator;message-bus;dotnet</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackSourceGeneratorAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="MinVer" Version="7.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caravelle.Generator\Caravelle.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackSourceGeneratorAnalyzer">
    <MSBuild Projects="..\Caravelle.Generator\Caravelle.Generator.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_CaravelleGeneratorTargetPath" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_CaravelleGeneratorTargetPath)">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
